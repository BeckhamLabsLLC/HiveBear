# HiveBear — Vulkan-only Docker image
# Usage: docker run -it --rm --device /dev/dri --device /dev/kfd -p 11434:11434 ghcr.io/beckhamlabsllc/hivebear:vulkan quickstart

# --- Builder stage ---
FROM rust:1.97-slim-bookworm AS builder

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    g++ \
    clang \
    libclang-dev \
    build-essential \
    git \
# Vulkan SDK required utilities
    xz-utils wget curl \
# Vulkan SDK required dependencies
    libssl-dev libxcb-xinput0 libxcb-xinerama0 libxcb-cursor-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# --- Install Vulkan SDK ---
ARG VULKANSDK_VERSION="1.4.321.1"
ENV VULKANSDK_VERSION=$VULKANSDK_VERSION
RUN scripts/download-vulkan-sdk.sh ${VULKANSDK_VERSION} \
    && mkdir vulkan \
    && cd vulkan \
    && tar xf ../vulkansdk-linux.tar.xz \
    && rm ../vulkansdk-linux.tar.xz
RUN source /build/vulkan/${VULKANSDK_VERSION}/setup-env.sh \
    && cargo build --release -p hivebear-cli --features llamacpp-vulkan \
    && strip target/release/hivebear

# --- Runtime stage ---
FROM debian:bookworm-slim

# libgomp1: llama.cpp is built with OpenMP, so the binary links libgomp.so.1.
# The builder stage gets it via g++; this stage does not, and without it the
# image builds perfectly and then dies on every run with
# "error while loading shared libraries: libgomp.so.1".
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/hivebear /usr/local/bin/hivebear

# Create the non-root user and its data directory BEFORE declaring the volume.
# VOLUME does not create the directory, so the chown had nothing to act on
# ("chown: cannot access '/data'"), and anything written to a volume path after
# VOLUME is declared is discarded by the builder anyway.
RUN groupadd -r hivebear && useradd -r -g hivebear -d /data -s /sbin/nologin hivebear \
    && mkdir -p /data /opt \
    && chown -R hivebear:hivebear /data

# Default model storage inside container
ENV HIVEBEAR_DATA_DIR=/data
VOLUME /data

ARG VULKANSDK_VERSION="1.4.321.1"
COPY --from=builder /build/vulkan/$VULKANSDK_VERSION/x86_64/ /opt/vulkan

ENV PATH="/opt/vulkan/bin:$PATH"
RUN echo "/opt/vulkan/lib" > /etc/ld.so.conf.d/vulkan.conf && ldconfig

USER hivebear

EXPOSE 11434

ENTRYPOINT ["hivebear"]
CMD ["quickstart"]
