{
  "identifier": "mobile",
  "description": "HiveBear mobile permissions",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://hivebear.com/*" },
        { "url": "https://www.hivebear.com/*" },
        { "url": "https://github.com/BeckhamLabsLLC/*" },
        { "url": "https://checkout.stripe.com/*" }
      ]
    }
  ]
}
